{
  "name": "pi-subagents",
  "version": "0.4.3",
  "private": true,
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "lint": "oxlint",
    "check": "npm run lint && tsc --noEmit",
    "test": "node --test --experimental-strip-types extensions/subagents/manager.test.ts extensions/subagents/activity-card.test.ts extensions/subagents/browser-protocol.test.ts extensions/subagents/result-delivery.test.ts extensions/subagents/parent-coordinator.test.ts extensions/subagents/context-usage.test.ts extensions/subagents/reasoning-effort.test.ts extensions/subagents/takeover.test.ts extensions/subagents/headless-dialog.test.ts extensions/subagents/client-api.test.ts",
    "test:live": "node --test --experimental-strip-types extensions/subagents/claude.test.ts extensions/subagents/codex.test.ts",
    "format": "prettier --write \"extensions/**/*.ts\" \"skills/**/*.md\" \"*.{json,md}\"",
    "format:check": "prettier --check \"extensions/**/*.ts\" \"skills/**/*.md\" \"*.{json,md}\""
  },
  "pi": {
    "extensions": [
      "./extensions/subagents/index.ts",
      "./extensions/activity-rail/index.ts"
    ],
    "skills": [
      "./skills/subagents"
    ]
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.207",
    "effect": "4.0.0-beta.98"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.80.7",
    "@earendil-works/pi-coding-agent": "^0.80.7",
    "@earendil-works/pi-tui": "^0.80.7",
    "@oxlint/plugins": "1.79.0",
    "@types/node": "^24.0.0",
    "oxlint": "1.79.0",
    "prettier": "^3.6.0",
    "typebox": "^1.0.0",
    "typescript": "^5.9.0"
  }
}
